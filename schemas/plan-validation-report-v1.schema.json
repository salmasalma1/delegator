{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelly.local/schemas/plan-validation-report-v1.schema.json",
  "title": "NELLY Plan Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "valid",
    "decision",
    "errors",
    "warnings",
    "semantic_check"
  ],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "decision": {
      "enum": [
        "approved_for_delegation",
        "rejected",
        "needs_repair"
      ]
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "reason"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "policy_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "semantic_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "skipped",
            "error"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
