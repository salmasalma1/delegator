{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nelly:contracts:01_proposedaction",
  "title": "NELLY ProposedAction",
  "description": "Action proposal generated by the Brain and evaluated by Team 3.",
  "type": "object",
  "required": [
    "action_id",
    "task_id",
    "action_type",
    "application",
    "risk_level",
    "reversible",
    "strategy"
  ],
  "properties": {
    "action_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "action_type": {
      "type": "string"
    },
    "target_element_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "application": {
      "type": "string",
      "enum": [
        "Chrome",
        "Edge",
        "Notepad",
        "File Explorer",
        "Basic System Dialog"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "reversible": {
      "type": "boolean"
    },
    "requires_user_confirmation": {
      "type": "boolean"
    },
    "strategy": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
