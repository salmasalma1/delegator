{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nelly:contracts:02_visionresult",
  "title": "NELLY VisionResult",
  "description": "Structured screen-analysis result returned by Team 1.",
  "type": "object",
  "required": [
    "request_id",
    "task_id",
    "status",
    "elements"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "application": {
      "type": [
        "string",
        "null"
      ]
    },
    "window_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UIElement"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "UIElement": {
      "type": "object",
      "required": [
        "element_id",
        "type",
        "bbox",
        "confidence",
        "interactable"
      ],
      "properties": {
        "element_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interactable": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "uia",
            "ocr",
            "vision",
            "dom",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "BoundingBox": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
