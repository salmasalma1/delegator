# Copy to .env and fill in. .env is git-ignored; never commit a real key, never paste it into logs or issues.

# --- Model (any OpenAI-compatible provider). These are used first.
NELLY_LLM_API_KEY=PUT_YOUR_KEY_HERE
NELLY_LLM_BASE_URL=https://your-provider.example/v1
# Always set the model when you set a base URL (otherwise a start-up warning: the built-in default would be sent).
NELLY_LLM_MODEL=your-model-name
# NELLY_LLM_TIMEOUT=60

# --- Verify: "rule" = offline structural check; "vlm" = screenshot check with the model above (needs a vision model).
NELLY_VERIFIER=rule

# --- Team 1 vision: path to the trained detector (without it vision may fall back to weak edge proposals).
NELLY_DETECTOR_WEIGHTS=C:\path\to\models\nelly_ui_v2_pilot\best.pt

# --- LEGACY (DashScope). Used ONLY when no NELLY_LLM_* variable is set; ignored otherwise.
# DASHSCOPE_API_KEY=PUT_YOUR_KEY_HERE
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
